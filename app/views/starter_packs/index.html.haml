- content_for :title, 'Starter packs'
.row
  .col-12
    .card
      .card-header
        %h3.card-title Your starter packs
        .card-tools
          = link_to new_starter_pack_path, class: 'btn btn-sm btn-danger ml-3 no-hover' do
            Create a starter pack
            = image_tag 'icons/circle-plus.svg', class: 'ml-2', width: 16, height: 16, alt: ''
      .card-body
        = search_form_for @search, url: starter_packs_path do |form|
          .row.mb-3
            .col-md-5
              = form.label :title_cont, 'Title'
              = form.search_field :title_cont, class: 'form-control'
            .col-md-5
              = form.label :instance_name_eq, 'Instance'
              = form.search_field :instance_name_eq, class: 'form-control'
            .col-md-2.align-self-end
              = form.submit 'Filter', class: 'btn btn-secondary'
        .table-responsive
          %table.table.no-side-borders.top-bottom-border
            %thead
              %tr
                %th Title
                %th Instance
                %th Created by
                %th Total accounts
                %th Display order
                %th Actions
            %tbody
              - @records.each do |pack|
                %tr
                  %td= link_to pack.title, starter_pack_path(pack)
                  %td= pack.instance_name
                  %td= pack.created_by&.display_name.presence || pack.created_by&.username
                  %td= @total_accounts.fetch(pack.id, 0)
                  %td= pack.position
                  %td.text-nowrap
                    .d-inline-flex.flex-nowrap.align-items-center
                      = link_to starter_pack_path(pack), class: 'btn btn-sm btn-outline-secondary mr-2', title: 'Add accounts', aria: { label: 'Add accounts' } do
                        %i.fa-solid.fa-user-plus
                      = link_to edit_starter_pack_path(pack), class: 'btn btn-sm btn-outline-secondary mr-2', title: 'Edit' do
                        %i.fa-solid.fa-pen
                      = link_to starter_pack_path(pack), method: :delete, data: { confirm: 'Delete this starter pack?' }, class: 'btn btn-sm btn-outline-danger', title: 'Delete' do
                        %i.fa-solid.fa-trash
              - if @records.empty?
                %tr
                  %td.text-center.info-box-content{ colspan: 6 }
                    %p.text-muted.small No starter packs found.
                    = link_to 'Create a starter pack', new_starter_pack_path, class: 'text-danger small'
        .row.mt-2
          .col
            .pagination.pagination-sm.m-0.float-right
              = paginate @records, theme: 'bootstrap4'