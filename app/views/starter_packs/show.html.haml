- content_for :title, @starter_pack.title
.row
  .col-12
    .card
      .card-header
        %h3.card-title.text-break= @starter_pack.title
        .card-tools
          = link_to edit_starter_pack_path(@starter_pack), class: 'btn btn-sm btn-outline-secondary ml-3 no-hover' do
            %i.fa-solid.fa-pen
            Edit
      .card-body
        %dl.row
          %dt.col-sm-3 Description
          %dd.col-sm-9.text-break= @starter_pack.description
          %dt.col-sm-3 Instance
          %dd.col-sm-9.text-break= @starter_pack.instance_name
          %dt.col-sm-3 Created by
          %dd.col-sm-9.text-break= @starter_pack.created_by&.display_name.presence || @starter_pack.created_by&.username || 'Not assigned'
          %dt.col-sm-3 Total accounts
          %dd.col-sm-9= @members.size
        .d-flex.flex-wrap.justify-content-between.align-items-center.mb-3
          %h4.mb-2 Accounts
          %button.btn.btn-sm.btn-danger.mb-2{ type: 'button', data: { toggle: 'modal', target: '#starter-pack-account-search' } }
            Add account
            = image_tag 'icons/circle-plus.svg', class: 'ml-2', width: 16, height: 16, alt: ''
        %p.text-danger#starter-pack-member-error{ role: 'alert' }
        .table-responsive
          %table.table.no-side-borders.top-bottom-border
            %thead
              %tr
                %th Account
                %th Handle
                %th Actions
            %tbody#starter-pack-members{ data: { reorder_url: reorder_accounts_starter_pack_path(@starter_pack), remove_url: remove_account_starter_pack_path(@starter_pack) } }
              - @members.each_with_index do |member, index|
                %tr{ data: { membership_id: member.id, account_id: member.account_id } }
                  %td
                    = image_tag member.account.avatar_url, width: 32, height: 32, alt: '', loading: 'lazy'
                    = member.account.display_name.presence || member.account.username
                  %td= [member.account.username, member.account.domain].compact.join('@')
                  %td.text-nowrap
                    .d-inline-flex.flex-nowrap.align-items-center
                      %button.btn.btn-sm.btn-outline-secondary.mr-2{ type: 'button', data: { move: 'up' }, title: 'Move up', disabled: index.zero? }
                        %i.fa-solid.fa-arrow-up
                      %button.btn.btn-sm.btn-outline-secondary.mr-2{ type: 'button', data: { move: 'down' }, title: 'Move down', disabled: index == @members.size - 1 }
                        %i.fa-solid.fa-arrow-down
                      %button.btn.btn-sm.btn-outline-danger{ type: 'button', data: { remove: true }, title: 'Remove account' }
                        %i.fa-solid.fa-trash
              - if @members.empty?
                %tr
                  %td.text-center.info-box-content{ colspan: 3 }
                    %p.text-muted.small No accounts added.
    .row.d-flex.justify-content-between.mt-4
      .col-auto
        = link_to 'Back', starter_packs_path, class: 'btn btn-outline-secondary'
= render 'account_search', mode: 'member'